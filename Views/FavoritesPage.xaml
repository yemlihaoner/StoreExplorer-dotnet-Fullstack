<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreExplorer.Views.FavoritesPage"
             Title="Favorites"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Favorite Stores" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

            <VerticalStackLayout IsVisible="{Binding IsAuthenticated}" BindableLayout.ItemsSource="{Binding FavoriteStores}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource Gray900}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevated}, Dark={StaticResource Black}}" Padding="12" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.OpenStoreDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                <Label Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
                                <Label Text="{Binding Location.Address}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
                                <Button Text="Remove from favorites" Command="{Binding BindingContext.RemoveFavoriteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" TextColor="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource Gray200}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsAuthenticated, Converter={StaticResource InverseBoolConverter}}" Spacing="8" Padding="8">
                <Label Text="You are not signed in." FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
                <Label Text="Sign in to view and manage favorites." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Login" Command="{Binding NavigateToLoginCommand}" BackgroundColor="{StaticResource SecondaryBrush}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                    <Button Grid.Column="1" Text="Sign Up" Command="{Binding NavigateToSignUpCommand}" BackgroundColor="{StaticResource SecondaryBrush}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                </Grid>
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
