<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreExplorer.Views.ForgotPasswordPage"
             Title="Reset Password"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Reset Password" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
            
            <!-- General Error Banner -->
            <Border IsVisible="{Binding HasGeneralError}"
                    Padding="14,10"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{AppThemeBinding Light=#EF5350, Dark=#EF5350}"
                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#2C1A1D}">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="⚠" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#C62828, Dark=#EF5350}" VerticalOptions="Center"/>
                    <Label Text="{Binding GeneralError}" FontSize="13" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#C62828, Dark=#FFEBEE}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- STEP 1: Request Reset Code (Visible when code is NOT sent) -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsCodeSent, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Enter your registered email address to receive a password reset code." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
                
                <!-- Email Input Field -->
                <VerticalStackLayout Spacing="4">
                    <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                    <Label Text="{Binding EmailError}" IsVisible="{Binding HasEmailError}" FontSize="12" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}" Margin="4,0,0,0"/>
                </VerticalStackLayout>

                <Button Text="Get Reset Code" Command="{Binding RequestCodeCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </VerticalStackLayout>

            <!-- STEP 2: Verify Code and Reset Password (Visible when code IS sent) -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsCodeSent}">
                <Label Text="A password reset code has been generated. Enter the code and your new password below." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />

                <Label Text="{Binding Email, StringFormat='Email: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                <!-- Verification Code Input Field -->
                <VerticalStackLayout Spacing="4">
                    <Entry Placeholder="Verification Code" Keyboard="Numeric" Text="{Binding Code}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                    <Label Text="{Binding CodeError}" IsVisible="{Binding HasCodeError}" FontSize="12" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}" Margin="4,0,0,0"/>
                </VerticalStackLayout>

                <!-- New Password Input Field -->
                <VerticalStackLayout Spacing="4">
                    <Entry Placeholder="New Password" IsPassword="True" Text="{Binding NewPassword}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                    <Label Text="{Binding PasswordError}" IsVisible="{Binding HasPasswordError}" FontSize="12" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}" Margin="4,0,0,0" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Button Text="Reset Password" Command="{Binding ResetPasswordCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
