<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreExplorer.Views.SignUpPage"
             Title="Sign Up"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Create Account" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
            <Label Text="Use a strong password to keep your account secure." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />

            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
            <Entry Placeholder="Username" Text="{Binding UserName}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
            <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

            <Button Text="Sign Up" Command="{Binding SignUpCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
